# Which data source the dashboard reads. "fake" needs nothing else and is the default.
DATA_SOURCE=fake

# Seeded fake data source. Same values in, same dashboard out.
FAKE_SEED=42
FAKE_ANCHOR_WEEK=2026-W40
FAKE_WEEKS=26

# Only read when DATA_SOURCE=supabase. Server side only, never NEXT_PUBLIC.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
